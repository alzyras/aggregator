DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_USE_X_FORWARDED_HOST=0
DJANGO_TRUST_PROXY_SSL_HEADER=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=aggregator
# built_in uses the compose postgres service. external requires PGHOST to point
# at your existing Postgres host.
DB_DEPLOYMENT_MODE=built_in
VALIDATE_RUNTIME_CONFIG=1
STRICT_RUNTIME_CONFIG=0
# Optional maintenance DB override
# PGMAINTENANCE_DB=postgres

ENCRYPTION_KEY=

# Shared derived-data cache. Docker Compose defaults this to redis://redis:6379/1.
CACHE_URL=
CACHE_DEFAULT_TIMEOUT_SECONDS=300
CACHE_KEY_PREFIX=aggregator

# Provider credentials examples
ASANA_ACCESS_TOKEN=
TODOIST_API_TOKEN=
HABITICA_USER_ID=
HABITICA_API_TOKEN=
GITHUB_ISSUES_TOKEN=
GITHUB_ISSUES_REPOSITORIES=
LINEAR_API_KEY=
CLICKUP_API_TOKEN=
TRELLO_API_KEY=
TRELLO_API_TOKEN=

# Optional comma-separated connector allowlist. Empty enables every installed connector.
ENABLED_CONNECTORS=

# Google Fit OAuth placeholders
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
GOOGLE_FIT_REFRESH_TOKEN=
GOOGLE_FIT_ACCESS_TOKEN=

# Optional superuser bootstrap
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Background jobs
JOB_MAX_CONCURRENCY=4
JOB_MAX_ATTEMPTS=3
JOB_STALE_RUNNING_SECONDS=900
# Incremental sync re-reads a small overlap window to avoid missing changes during a run.
SYNC_INCREMENTAL_LOOKBACK_MINUTES=5
# Worker frequency for checking every workspace's automatic refresh policy.
AUTO_REFRESH_SCHEDULER_TICK_SECONDS=60
PLANNER_STATUS_WRITEBACK_MAX_RETRIES=3
PLANNER_DESCRIPTION_WRITEBACK_MAX_RETRIES=3

# Workspace AI: use OpenAI Responses or an OpenAI-compatible local Qwen server.
AI_DEFAULT_BACKEND=openai_responses
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
AI_QWEN_BASE_URL=
AI_QWEN_MODEL=qwen3
AI_QWEN_API_KEY=

# Docker runtime flags
AUTO_CREATE_DB=0
WAIT_FOR_DB=1
RUN_MIGRATIONS=1
COLLECT_STATIC=1
APP_PORT=8000
WEB_PORT=8000
WEB_BIND=127.0.0.1

# Cloudflare Tunnel (recommended for production behind Cloudflare)
CLOUDFLARE_TUNNEL_TOKEN=
