DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=aggregator
# Optional maintenance DB override
# PGMAINTENANCE_DB=postgres

ENCRYPTION_KEY=

# Provider credentials examples
ASANA_ACCESS_TOKEN=
TODOIST_API_TOKEN=
HABITICA_USER_ID=
HABITICA_API_TOKEN=

# Google Fit OAuth placeholders
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
GOOGLE_FIT_REFRESH_TOKEN=
GOOGLE_FIT_ACCESS_TOKEN=

# Optional superuser bootstrap
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Background jobs
JOB_MAX_CONCURRENCY=4

# Docker runtime flags
AUTO_CREATE_DB=0
WAIT_FOR_DB=1
RUN_MIGRATIONS=1
COLLECT_STATIC=1
APP_PORT=8000
WEB_PORT=8000
